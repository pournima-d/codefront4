# BATON defaults to baton-deterministic-extractor if unset.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATA_DIR: Directory for SQLite database, uploads, and daily backups.
DATA_DIR="./data"
